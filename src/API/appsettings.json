{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CsvMappings": {
    "Establishment": {
      "Columns": [
        "Identifier.Urn",
        "BasicDetails.Name",
        "BasicDetails.EstablishmentType",
        "BasicDetails.PhaseOfEducation",
        "BasicDetails.Status",
        "Address.Street",
        "Address.Town",
        "Address.Postcode"
      ],
      "Headers": [
        "URN",
        "EstablishmentName",
        "EstablishmentType",
        "PhaseOfEducation",
        "StatusCode",
        "Address_Street",
        "Address_Town",
        "Address_Postcode"
      ]
    },
    "EstablishmentGroup": {
      "Columns": [
        "Identifier.UID",
        "BasicDetails.Name",
        "BasicDetails.GroupType",
        "GroupEstablishments[].URN",
        "GroupEstablishments[].Name"
      ],
      "Headers": [
        "UID",
        "GroupName",
        "GroupType",
        "URN",
        "EstablishmentName"
      ]
    }
  },
  "DefaultRequiredFields": {
    "RequiredFields": {
      "Establishments": [
        "URN",
        "EstablishmentName",
        "EstablishmentType",
        "EducationPhase",
        "WebsiteAddress",
        "EducationPhase",
        "TelephoneNumber",
        "Street",
        "Town",
        "Postcode",
        "EstablishmentStatus"
      ],
      "EstablishmentGroups": [
        "UID",
        "GroupName",
        "GroupTypeName",
        "EstablishmentURN",
        "EstablishmentName"
      ]
    }
  }
}