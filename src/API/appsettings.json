{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CsvMappings": {
    "Establishment": {
      "Columns": [
        "Identifier.Urn",
        "BasicDetails.Name",
        "BasicDetails.EstablishmentType",
        "BasicDetails.PhaseOfEducation",
        "BasicDetails.Status",
        "Address.Street",
        "Address.Town",
        "Address.Postcode"
      ],
      "Headers": [
        "URN",
        "EstablishmentName",
        "EstablishmentType",
        "PhaseOfEducation",
        "StatusCode",
        "Address_Street",
        "Address_Town",
        "Address_Postcode"
      ]
    },
    "EstablishmentGroup": {
      "Columns": [
        "Identifier.UID",
        "BasicDetails.Name",
        "BasicDetails.GroupType",
        "GroupEstablishments[].URN",
        "GroupEstablishments[].Name"
      ],
      "Headers": [
        "UID",
        "GroupName",
        "GroupType",
        "URN",
        "EstablishmentName"
      ]
    }
  },
  "DefaultRequiredFields": {
    "RequiredFields": {
      "Establishments": [
        "URN",
        "EstablishmentName",
        "EstablishmentType",
        "EducationPhase",
        "WebsiteAddress",
        "EducationPhase",
        "TelephoneNumber",
        "Street",
        "Town",
        "Postcode",
        "EstablishmentStatus"
      ],
      "EstablishmentGroups": [
        "UID",
        "GroupName",
        "GroupTypeName",
        "EstablishmentURN",
        "EstablishmentName"
      ]
    }
  },
  "ValidationPatterns": {
    "Patterns": {
      "Street": "^(UNDEFINED|[\\p{L}\\p{N}'(\\)][\\p{L}\\p{N}\\s\\.,'\\/\\-\\–—\\&\\(\\):]{1,99})$",
      "Town": "^(UNDEFINED|[\\p{L}\\p{N}][\\p{L}\\p{N}\\s\\.,'\\/\\-\\(\\)\\&]{0,49})$",
      "Postcode": "^(UNDEFINED|(GIR 0AA|[A-Za-z]{1,2}[0-9][0-9A-Za-z]?\\s?[0-9][A-Za-z]{2}|[A-Za-z0-9][A-Za-z0-9\\s\\-\\/]{1,11}))$",
      "Website": "^(UNDEFINED|(?:https?:\\/\\/|www\\.)?[A-Za-z0-9.-]+\\.[A-Za-z]{2,}(?:\\/\\S*)?)$",
      "Telephone": "^(UNDEFINED|(?:\\d{7,14}|0\\d{6,13}|44\\d{5,12}))$"
    }
  },
  "ConnectionStrings": {
    "Edubase": "Host=db;Port=5432;Database=GIAS_prototype;Username=postgres;Password=postgres"
  }
}