{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CsvMappings": {
    "Establishment": {
      "Columns": [
        "Identifier.Urn",
        "BasicDetails.Name",
        "BasicDetails.EstablishmentType",
        "BasicDetails.PhaseOfEducation",
        "BasicDetails.Status",
        "Address.Street",
        "Address.Town",
        "Address.Postcode"
      ],
      "Headers": [
        "URN",
        "EstablishmentName",
        "EstablishmentType",
        "PhaseOfEducation",
        "StatusCode",
        "Address_Street",
        "Address_Town",
        "Address_Postcode"
      ]
    }
  }
}
