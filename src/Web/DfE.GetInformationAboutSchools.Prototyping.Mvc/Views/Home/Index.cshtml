@{
    ViewData["Title"] = "Search Prototype";
}

<div class="container mt-5" style="max-width: 650px;">
    <h2 class="mb-3">Fuzzy Type‑Ahead Search</h2>
    <p class="text-muted mb-4">
        Start typing a <strong>URN</strong>, <strong>school name</strong>, or <strong>location</strong>.
    </p>

    <div class="position-relative">
        <input id="searchBox"
               type="text"
               class="form-control form-control-lg"
               placeholder="e.g. 10566, Riverdale, London"
               autocomplete="off" />

        <div id="resultsContainer"
             class="position-absolute w-100 shadow-sm"
             style="top: 100%; left: 0; z-index: 2000; display: none;">
            <ul id="results"
                class="list-group rounded-0"
                style="max-height: 300px; overflow-y: auto;">
            </ul>
        </div>
    </div>

    <hr class="my-5" />

    <h2 class="mb-3">Filtered Search</h2>

    <div class="row g-3">

        <!-- STATUS MULTI-SELECT -->
        <div class="col-md-6">
            <label class="form-label fw-bold">Status</label>
            <div>
                <label><input type="checkbox" name="status" value="Open"> Open</label><br>
                <label><input type="checkbox" name="status" value="Closed"> Closed</label>
            </div>
        </div>

        <!-- TYPE MULTI-SELECT -->
        <div class="col-md-6">
            <label class="form-label fw-bold">Type</label>
            <div>
                <label><input type="checkbox" name="type" value="Academy"> Academy</label><br>
                <label><input type="checkbox" name="type" value="Community school"> Community school</label><br>
                <label><input type="checkbox" name="type" value="Voluntary aided school"> Voluntary aided school</label><br>
                <label><input type="checkbox" name="type" value="British schools overseas"> British schools overseas</label>
            </div>
        </div>

        <div class="col-12 d-flex align-items-end mt-3">
            <button id="runFilter" class="btn btn-primary w-100">Apply Filters</button>
        </div>
    </div>

    <div class="mt-4">
        <h5>Filtered Results</h5>
        <ul id="filteredResults" class="list-group"></ul>
    </div>
</div>

@section Scripts {
    <script>
        // -------------------------------
        // FUZZY TYPEAHEAD
        // -------------------------------
        const searchBox = document.getElementById("searchBox");
        const resultsContainer = document.getElementById("resultsContainer");
        const results = document.getElementById("results");
        let debounceTimer = null;

        searchBox.addEventListener("input", () => {
            const term = searchBox.value.trim();

            clearTimeout(debounceTimer);

            if (term.length === 0) {
                resultsContainer.style.display = "none";
                results.innerHTML = "";
                return;
            }

            debounceTimer = setTimeout(() => {
                fetch(`/typeahead?term=${encodeURIComponent(term)}`)
                    .then(r => r.json())
                    .then(data => {
                        results.innerHTML = "";

                        if (!data || data.length === 0) {
                            resultsContainer.style.display = "none";
                            return;
                        }

                        data.forEach(item => {
                            const li = document.createElement("li");
                            li.className = "list-group-item list-group-item-action py-2";

                            li.innerHTML = `
                                <div class="fw-bold">${item.establishmentName}</div>
                                <div class="text-muted small">
                                    URN: ${item.urn} &nbsp;•&nbsp; ${item.town ?? ""}
                                </div>
                            `;

                            li.addEventListener("click", () => {
                                searchBox.value = item.establishmentName;
                                resultsContainer.style.display = "none";
                            });

                            results.appendChild(li);
                        });

                        resultsContainer.style.display = "block";
                    });
            }, 200);
        });

        document.addEventListener("click", (e) => {
            if (!resultsContainer.contains(e.target) && e.target !== searchBox) {
                resultsContainer.style.display = "none";
            }
        });

        // -------------------------------
        // FILTERED SEARCH (MULTI-SELECT)
        // -------------------------------
        document.getElementById("runFilter").addEventListener("click", () => {

            const statuses = [...document.querySelectorAll("input[name='status']:checked")]
                .map(cb => cb.value);

            const types = [...document.querySelectorAll("input[name='type']:checked")]
                .map(cb => cb.value);

            const params = new URLSearchParams();

            statuses.forEach(s => params.append("statuses", s));
            types.forEach(t => params.append("types", t));

            fetch(`/filtered?${params.toString()}`)
                .then(r => r.json())
                .then(data => {
                    const list = document.getElementById("filteredResults");
                    list.innerHTML = "";

                    data.results.forEach(item => {
                        const li = document.createElement("li");
                        li.className = "list-group-item";

                        li.innerHTML = `
                            <div class="fw-bold">${item.name}</div>
                            <div class="text-muted small">
                                URN: ${item.urn}
                                &nbsp;•&nbsp; ${item.type}
                                &nbsp;•&nbsp; ${item.phase}
                                &nbsp;•&nbsp; ${item.status}
                                &nbsp;•&nbsp; ${item.town ?? ""}
                            </div>
                        `;

                        list.appendChild(li);
                    });
                });
        });
    </script>
}
