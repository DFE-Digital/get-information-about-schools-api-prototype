@{
    ViewData["Title"] = "Search Prototype";
}

<div class="container mt-5">

    <!-- ============================= -->
    <!-- FUZZY TYPEAHEAD SEARCH (TOP) -->
    <!-- ============================= -->
    <h2 class="mb-3">Fuzzy Type‑Ahead Search</h2>
    <p class="text-muted mb-4">
        Start typing a <strong>URN</strong>, <strong>school name</strong>, or <strong>location</strong>.
    </p>

    <div class="position-relative mb-5" style="max-width: 650px;">
        <input id="searchBox"
               type="text"
               class="form-control form-control-lg"
               placeholder="e.g. 10566, Riverdale, London"
               autocomplete="off" />

        <div id="resultsContainer"
             class="position-absolute w-100 shadow-sm"
             style="top: 100%; left: 0; z-index: 2000; display: none;">
            <ul id="results"
                class="list-group rounded-0"
                style="max-height: 300px; overflow-y: auto;">
            </ul>
        </div>
    </div>

    <!-- ============================= -->
    <!-- FILTER + RESULTS 2-COLUMN LAYOUT -->
    <!-- ============================= -->
    <div class="row">

        <!-- ============================= -->
        <!-- LEFT COLUMN: FILTERS         -->
        <!-- ============================= -->
        <div class="col-md-4">

            <h4 class="mb-3">Filters</h4>

            <!-- STATUS FILTER -->
            <div class="mb-4">
                <label class="form-label fw-bold">Status</label>
                <div id="statusFacetContainer">
                    <label><input type="checkbox" name="status" value="Open"> Open <span class="text-muted small facet-count" data-facet="Open"></span></label><br>
                    <label><input type="checkbox" name="status" value="Closed"> Closed <span class="text-muted small facet-count" data-facet="Closed"></span></label>
                </div>
            </div>

            <!-- TYPE FILTER -->
            <div class="mb-4">
                <label class="form-label fw-bold">Type</label>
                <div id="typeFacetContainer">
                    <label><input type="checkbox" name="type" value="Academy"> Academy <span class="text-muted small facet-count" data-facet="Academy"></span></label><br>
                    <label><input type="checkbox" name="type" value="Community school"> Community school <span class="text-muted small facet-count" data-facet="Community school"></span></label><br>
                    <label><input type="checkbox" name="type" value="Voluntary aided school"> Voluntary aided school <span class="text-muted small facet-count" data-facet="Voluntary aided school"></span></label><br>
                    <label><input type="checkbox" name="type" value="British schools overseas"> British schools overseas <span class="text-muted small facet-count" data-facet="British schools overseas"></span></label>
                </div>
            </div>

            <button id="runFilter" class="btn btn-primary w-100">Apply Filters</button>
        </div>

        <!-- ============================= -->
        <!-- RIGHT COLUMN: RESULTS         -->
        <!-- ============================= -->
        <div class="col-md-8">

            <h4 class="d-flex justify-content-between align-items-center mb-3">
                <span>Filtered Results</span>
                <span id="resultsSummary" class="text-muted small"></span>
            </h4>

            <ul id="filteredResults" class="list-group"></ul>

            <nav class="mt-3">
                <ul id="pagination" class="pagination"></ul>
            </nav>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        /* -------------------------------------------------------------
           FUZZY SEARCH (unchanged)
        ------------------------------------------------------------- */
        const searchBox = document.getElementById("searchBox");
        const resultsContainer = document.getElementById("resultsContainer");
        const results = document.getElementById("results");
        let debounceTimer = null;

        searchBox.addEventListener("input", () => {
            const term = searchBox.value.trim();
            clearTimeout(debounceTimer);

            if (term.length === 0) {
                resultsContainer.style.display = "none";
                results.innerHTML = "";
                return;
            }

            debounceTimer = setTimeout(() => {
                fetch(`/typeahead?term=${encodeURIComponent(term)}`)
                    .then(r => r.json())
                    .then(data => {
                        results.innerHTML = "";

                        if (!data || data.length === 0) {
                            resultsContainer.style.display = "none";
                            return;
                        }

                        data.forEach(item => {
                            const li = document.createElement("li");
                            li.className = "list-group-item list-group-item-action py-2";

                            li.innerHTML = `
                                <div class="fw-bold">${item.establishmentName}</div>
                                <div class="text-muted small">
                                    URN: ${item.urn} &nbsp;•&nbsp; ${item.town ?? ""}
                                </div>
                            `;

                            li.addEventListener("click", () => {
                                searchBox.value = item.establishmentName;
                                resultsContainer.style.display = "none";
                            });

                            results.appendChild(li);
                        });

                        resultsContainer.style.display = "block";
                    });
            }, 200);
        });

        document.addEventListener("click", (e) => {
            if (!resultsContainer.contains(e.target) && e.target !== searchBox) {
                resultsContainer.style.display = "none";
            }
        });

        /* -------------------------------------------------------------
           FILTERED SEARCH + FACETS + PAGINATION
        ------------------------------------------------------------- */
        let currentPage = 1;
        const pageSize = 20;

        document.getElementById("runFilter").addEventListener("click", () => {
            currentPage = 1;
            runFilteredSearch(currentPage);
        });

        function runFilteredSearch(page) {
            const statuses = [...document.querySelectorAll("input[name='status']:checked")].map(cb => cb.value);
            const types = [...document.querySelectorAll("input[name='type']:checked")].map(cb => cb.value);

            const params = new URLSearchParams();
            statuses.forEach(s => params.append("statuses", s));
            types.forEach(t => params.append("types", t));
            params.append("pageNumber", page);
            params.append("pageSize", pageSize);

            fetch(`/filtered?${params.toString()}`)
                .then(r => r.json())
                .then(data => {
                    renderResults(data.results);
                    renderPagination(data.totalCount, page);
                    renderSummary(data.totalCount, page, data.results.length);
                    renderFacets(data.facets);
                });
        }

        /* -------------------------------------------------------------
           RENDER RESULTS
        ------------------------------------------------------------- */
        function renderResults(items) {
            const list = document.getElementById("filteredResults");
            list.innerHTML = "";

            items.forEach(item => {
                const li = document.createElement("li");
                li.className = "list-group-item";

                li.innerHTML = `
                    <div class="fw-bold">${item.name}</div>
                    <div class="text-muted small">
                        URN: ${item.urn}
                        &nbsp;•&nbsp; ${item.type}
                        &nbsp;•&nbsp; ${item.phase}
                        &nbsp;•&nbsp; ${item.status}
                        &nbsp;•&nbsp; ${item.town ?? ""}
                    </div>
                `;

                list.appendChild(li);
            });
        }

        /* -------------------------------------------------------------
           INLINE RESULTS SUMMARY
        ------------------------------------------------------------- */
        function renderSummary(totalCount, currentPage, pageCount) {
            const summary = document.getElementById("resultsSummary");

            if (totalCount === 0) {
                summary.textContent = "No results found";
                return;
            }

            const start = (currentPage - 1) * pageSize + 1;
            const end = start + pageCount - 1;

            summary.textContent = `Showing ${start}–${end} of ${totalCount}`;
        }

        /* -------------------------------------------------------------
           FACET COUNTS
        ------------------------------------------------------------- */
        function renderFacets(facets) {
            document.querySelectorAll("#statusFacetContainer .facet-count").forEach(span => {
                const key = span.dataset.facet;
                span.textContent = facets.statusCounts[key] !== undefined
                    ? `(${facets.statusCounts[key]})`
                    : "(0)";
            });

            document.querySelectorAll("#typeFacetContainer .facet-count").forEach(span => {
                const key = span.dataset.facet;
                span.textContent = facets.typeCounts[key] !== undefined
                    ? `(${facets.typeCounts[key]})`
                    : "(0)";
            });
        }

        /* -------------------------------------------------------------
           PAGINATION WITH ELLIPSES
        ------------------------------------------------------------- */
        function renderPagination(totalCount, currentPage) {
            const totalPages = Math.ceil(totalCount / pageSize);
            const pagination = document.getElementById("pagination");
            pagination.innerHTML = "";

            if (totalPages <= 1) return;

            function addPage(number, label = null, disabled = false, active = false) {
                const li = document.createElement("li");
                li.className = `page-item ${disabled ? "disabled" : ""} ${active ? "active" : ""}`;
                li.innerHTML = `<a class="page-link" href="#">${label ?? number}</a>`;
                if (!disabled && !active) {
                    li.onclick = () => {
                        currentPage = number;
                        runFilteredSearch(currentPage);
                    };
                }
                pagination.appendChild(li);
            }

            function addEllipsis() {
                const li = document.createElement("li");
                li.className = "page-item disabled";
                li.innerHTML = `<span class="page-link">…</span>`;
                pagination.appendChild(li);
            }

            addPage(currentPage - 1, "Previous", currentPage === 1);
            addPage(1, "1", false, currentPage === 1);

            if (currentPage > 3) addEllipsis();
            if (currentPage - 1 > 1) addPage(currentPage - 1);
            if (currentPage !== 1 && currentPage !== totalPages) addPage(currentPage, `${currentPage}`, false, true);
            if (currentPage + 1 < totalPages) addPage(currentPage + 1);
            if (currentPage < totalPages - 2) addEllipsis();

            addPage(totalPages, `${totalPages}`, false, currentPage === totalPages);
            addPage(currentPage + 1, "Next", currentPage === totalPages);
        }
    </script>
}
